{{!
    @template local_accessibility/readbar

    Read-aloud controls (spec §5). Outside the dialog, so it stays usable while the panel is closed.

    Example context (json):
    {}
}}
<div class="la-readbar" role="region" aria-label="{{#str}} readaloud, local_accessibility {{/str}}" hidden>
    <button type="button" class="btn btn-sm btn-primary" data-read="play">{{#str}} readplay, local_accessibility {{/str}}</button>
    <button type="button" class="btn btn-sm btn-secondary" data-read="stop">{{#str}} readstop, local_accessibility {{/str}}</button>
    <button type="button" class="btn btn-sm btn-secondary" data-read="restart">{{#str}} readrestart, local_accessibility {{/str}}</button>
    <label class="la-rate">{{#str}} readspeed, local_accessibility {{/str}}
        <select data-read="rate">
            <option value="0.8">0.8×</option>
            <option value="1" selected>1×</option>
            <option value="1.25">1.25×</option>
            <option value="1.5">1.5×</option>
        </select>
    </label>
    <span class="la-readmsg" role="status" data-read="message"></span>
</div>
