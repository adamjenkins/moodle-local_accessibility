{{!
    @template local_accessibility/view_narrow

    The line width detail view (numeric steppers brief): a Less/More stepper in characters, with a bar as wide as the
    line. Behaviour is in local_accessibility/panel.

    Context variables required for this template:
    * id, label, locked - the view (id "narrow")
    * stepper - the line width stepper (see local_accessibility/stepper)

    Example context (json):
    {"id": "narrow", "label": "Line width", "locked": false, "isnarrow": true,
     "stepper": {"feature": "narrow", "label": "Line width", "labelid": "la-view-narrow-title", "showlabel": false,
        "fieldvalue": "60", "placeholder": "", "unit": "characters", "issize": false, "locked": false,
        "mindisabled": false, "maxdisabled": false, "sample": null, "samplestyle": null, "bar": 67}
    }
}}
<section class="la-view la-view-{{id}}" id="la-view-{{id}}" data-view="{{id}}" aria-labelledby="la-view-{{id}}-title" hidden>
    <div class="la-viewhead">
        <button type="button" class="btn btn-sm la-back" data-action="back">
            <i class="icon fa fa-chevron-left" aria-hidden="true"></i>{{#str}} allsettings, local_accessibility {{/str}}
        </button>
        <h3 class="la-viewtitle" id="la-view-{{id}}-title" tabindex="-1">{{label}}</h3>
        {{#locked}}<i class="icon fa fa-lock la-viewlock" aria-hidden="true"></i>{{/locked}}
    </div>
    {{#stepper}}{{> local_accessibility/stepper }}{{/stepper}}
</section>
