{{!
    @template local_accessibility/view_narrow

    The line width detail view (choices spec §3 narrow): each option shows a bar as wide as its line. Behaviour is in
    local_accessibility/panel.

    Context variables required for this template:
    * id, label, locked - the view (id "narrow")
    * options - one per width (see local_accessibility/option), each with its bar width

    Example context (json):
    {"id": "narrow", "label": "Line width", "locked": false, "isnarrow": true, "options": [
        {"feature": "narrow", "value": "off", "label": "Full width", "icon": null, "sample": null, "samplestyle": null,
         "labelstyle": null, "bar": 100, "faces": null, "swatch": false, "checked": true, "focusable": true,
         "locked": false},
        {"feature": "narrow", "value": "60", "label": "60 characters", "icon": null, "sample": null,
         "samplestyle": null, "labelstyle": null, "bar": 67, "faces": null, "swatch": false, "checked": false,
         "focusable": false, "locked": false}
    ]}
}}
<section class="la-view la-view-{{id}}" id="la-view-{{id}}" data-view="{{id}}" aria-labelledby="la-view-{{id}}-title" hidden>
    <div class="la-viewhead">
        <button type="button" class="btn btn-sm la-back" data-action="back">
            <i class="icon fa fa-chevron-left" aria-hidden="true"></i>{{#str}} allsettings, local_accessibility {{/str}}
        </button>
        <h3 class="la-viewtitle" id="la-view-{{id}}-title" tabindex="-1">{{label}}</h3>
        {{#locked}}<i class="icon fa fa-lock la-viewlock" aria-hidden="true"></i>{{/locked}}
    </div>
    <div class="la-options la-widths" role="radiogroup" aria-labelledby="la-view-{{id}}-title" {{#locked}}aria-disabled="true"{{/locked}}>
        {{#options}}{{> local_accessibility/option }}{{/options}}
    </div>
</section>
