{{!
    @template local_accessibility/admin/features

    Admin list of the built-in features: enable, disable and order them.
    Derived from Ponlawat Weerapanpisit's enabledwidgets template.

    Context variables required for this template:
    * rows - features in admin order
      * id - feature id
      * label - feature name
      * enabled - whether the feature is offered to users
      * canup - whether it can move up
      * candown - whether it can move down
      * actionurls - toggle, up and down URLs, each with sesskey

    Example context (json):
    {
        "rows": [
            {
                "id": "size",
                "label": "Text size",
                "enabled": true,
                "canup": false,
                "candown": true,
                "actionurls": {
                    "toggle": "https://my.moodle/local/accessibility/admin/features.php?action=disable&feature=size",
                    "up": "https://my.moodle/local/accessibility/admin/features.php?action=up&feature=size",
                    "down": "https://my.moodle/local/accessibility/admin/features.php?action=down&feature=size"
                }
            }
        ]
    }
}}
<table class="generaltable local-accessibility-features">
    <thead>
        <tr>
            <th scope="col">{{#str}} featurename, local_accessibility {{/str}}</th>
            <th scope="col">{{#str}} status {{/str}}</th>
            <th scope="col">{{#str}} actions {{/str}}</th>
        </tr>
    </thead>
    <tbody>
    {{#rows}}
        <tr data-feature="{{id}}">
            <th scope="row">{{label}}</th>
            <td>{{#enabled}}{{#str}} enabled, admin {{/str}}{{/enabled}}{{^enabled}}{{#str}} disabled, admin {{/str}}{{/enabled}}</td>
            <td>
                <a class="btn btn-secondary btn-sm" href="{{actionurls.toggle}}">
                    {{#enabled}}{{#str}} disable {{/str}}{{/enabled}}{{^enabled}}{{#str}} enable {{/str}}{{/enabled}}
                    <span class="la-visually-hidden">{{label}}</span>
                </a>
                {{#canup}}
                <a class="btn btn-link btn-sm" href="{{actionurls.up}}">
                    <i class="icon fa fa-arrow-up" aria-hidden="true"></i>
                    <span class="la-visually-hidden">{{#str}} moveup {{/str}} {{label}}</span>
                </a>
                {{/canup}}
                {{#candown}}
                <a class="btn btn-link btn-sm" href="{{actionurls.down}}">
                    <i class="icon fa fa-arrow-down" aria-hidden="true"></i>
                    <span class="la-visually-hidden">{{#str}} movedown {{/str}} {{label}}</span>
                </a>
                {{/candown}}
            </td>
        </tr>
    {{/rows}}
    </tbody>
</table>
