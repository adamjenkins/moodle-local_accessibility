{{!
    @template local_accessibility/drawer

    A short-list feature's options, shown under its tile's row across the grid (choices spec §2). Hidden until its
    tile opens it. Behaviour is in local_accessibility/panel.

    Context variables required for this template:
    * id - the feature id; the drawer element id is la-drawer- followed by it (the tile's aria-controls)
    * label - the feature name, which labels the radio group
    * locked - whether the admin locked the feature
    * options - radio options (see local_accessibility/option)

    Example context (json):
    {"id": "align", "label": "Alignment", "locked": false, "options": [
        {"feature": "align", "value": "default", "label": "Site default", "icon": "fa-rotate-left", "sample": null,
         "samplestyle": null, "labelstyle": null, "bar": null, "faces": null, "swatch": false, "checked": false,
         "focusable": false, "locked": false},
        {"feature": "align", "value": "center", "label": "Centre", "icon": "fa-align-center", "sample": null,
         "samplestyle": null, "labelstyle": null, "bar": null, "faces": null, "swatch": false, "checked": true,
         "focusable": true, "locked": false}
    ]}
}}
<div class="la-drawer" id="la-drawer-{{id}}" data-drawer="{{id}}" hidden>
    <p class="la-grouplabel" id="la-drawer-{{id}}-label">{{label}}</p>
    <div class="la-options" role="radiogroup" aria-labelledby="la-drawer-{{id}}-label" {{#locked}}aria-disabled="true"{{/locked}}>
        {{#options}}{{> local_accessibility/option }}{{/options}}
    </div>
</div>
