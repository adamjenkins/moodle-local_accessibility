{{!
    @template local_accessibility/view_spacing

    The spacing detail view (choices spec §3 Spacing): one radio group per enabled spacing feature, each option
    showing sample text with its spacing. Behaviour is in local_accessibility/panel.

    Context variables required for this template:
    * id, label, locked - the view (id "spacing")
    * groups - id, label, locked and options (see local_accessibility/option) per enabled spacing feature

    Example context (json):
    {"id": "spacing", "label": "Spacing", "locked": false, "isspacing": true, "groups": [
        {"id": "lineheight", "label": "Line height", "locked": false, "options": [
            {"feature": "lineheight", "value": "default", "label": "Site default", "icon": null, "sample": "Aa Bb Cc Dd",
             "samplestyle": "line-height: normal", "labelstyle": null, "bar": null, "faces": null, "swatch": false,
             "checked": false, "focusable": false, "locked": false},
            {"feature": "lineheight", "value": "180", "label": "1.8", "icon": null, "sample": "Aa Bb Cc Dd",
             "samplestyle": "line-height: 1.8", "labelstyle": null, "bar": null, "faces": null, "swatch": false,
             "checked": true, "focusable": true, "locked": false}
        ]}
    ]}
}}
<section class="la-view la-view-{{id}}" id="la-view-{{id}}" data-view="{{id}}" aria-labelledby="la-view-{{id}}-title" hidden>
    <div class="la-viewhead">
        <button type="button" class="btn btn-sm la-back" data-action="back">
            <i class="icon fa fa-chevron-left" aria-hidden="true"></i>{{#str}} allsettings, local_accessibility {{/str}}
        </button>
        <h3 class="la-viewtitle" id="la-view-{{id}}-title" tabindex="-1">{{label}}</h3>
        {{#locked}}<i class="icon fa fa-lock la-viewlock" aria-hidden="true"></i>{{/locked}}
    </div>
    {{#groups}}
    <div class="la-group">
        <h4 class="la-grouplabel" id="la-group-{{id}}">{{label}}</h4>
        <div class="la-options la-spacings" role="radiogroup" aria-labelledby="la-group-{{id}}" {{#locked}}aria-disabled="true"{{/locked}}>
            {{#options}}{{> local_accessibility/option }}{{/options}}
        </div>
    </div>
    {{/groups}}
</section>
