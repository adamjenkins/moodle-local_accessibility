{{!
    @template local_accessibility/panel

    The launcher and the accessibility settings dialog (minimal; the full template comes in Task 10).

    Context variables required for this template:
    * floating - whether to show the floating launcher button
    * tiles - one entry per enabled feature: id, label

    Example context (json):
    {
        "floating": true,
        "tiles": [
            {"id": "size", "label": "Text size"},
            {"id": "font", "label": "Readable font"}
        ]
    }
}}
<div class="local-accessibility">
    {{#floating}}
    <button type="button" class="la-launcher" aria-expanded="false" aria-controls="local-accessibility-panel">
        {{#str}} accessibilitysettings, local_accessibility {{/str}}
    </button>
    {{/floating}}
    <div id="local-accessibility-panel" class="la-panel" role="dialog" aria-modal="true"
        aria-labelledby="local-accessibility-panel-title" hidden>
        <h2 id="local-accessibility-panel-title" class="la-panel-title">
            {{#str}} accessibilitysettings, local_accessibility {{/str}}
        </h2>
        <div class="la-tiles">
            {{#tiles}}
            <button type="button" class="la-tile" data-feature="{{id}}">{{label}}</button>
            {{/tiles}}
        </div>
    </div>
</div>
